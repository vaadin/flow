<?xml version="1.0" encoding="UTF-8"?>
<!-- Global Maven settings for CI, passed with -gs in MAVEN_ARGS so that every
     mvn a workflow starts, including the ones tests fork, reads it. The user
     settings setup-java writes still apply on top.

     Central rate-limits by client IP, and GitHub-hosted runners share their IP
     ranges with every other project on GitHub, so a validation run's parallel
     jobs get 429 answers from repo.maven.apache.org. Central is read through
     Google's mirror of it instead, which serves the same artifacts without
     that limit. The mirror keeps the id central so that the
     _remote.repositories records in the cached ~/.m2/repository still name the
     repository a build resolves through; under another id Maven would no
     longer trust the cached copies and download them again.

     Some JBoss parent poms the wildfly-maven-plugin pulls in declare the public
     groups on repository.jboss.org and list them ahead of Maven Central for a
     few BOMs. When that host is slow or answers 503, every such artifact waits
     through the resolver's retries before falling back to Central, which costs
     the JBoss EAP dev loop job 7 to 11 minutes of its test budget. Everything
     the build resolves through them is also on Central, so they are read from
     the same Central mirror instead. A mirror matches repository ids, not
     hosts: the list holds every id the build's dependency poms give those
     groups under. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>central</id>
      <name>Google Cloud Storage mirror of Maven Central</name>
      <mirrorOf>central</mirrorOf>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
    </mirror>
    <mirror>
      <id>jboss-public-via-central</id>
      <mirrorOf>jboss-public-repository-group,jboss-public-repository,jboss,JBoss-Archive,nexus,public-jboss,public-jboss-plugins</mirrorOf>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
    </mirror>
  </mirrors>
</settings>
