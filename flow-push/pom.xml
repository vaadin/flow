<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.vaadin</groupId>
    <artifactId>flow-project</artifactId>
    <version>25.4-SNAPSHOT</version>
  </parent>
  <artifactId>flow-push</artifactId>
  <packaging>jar</packaging>
  <name>Flow Push</name>
  <description>${project.name}</description>

  <properties>
    <jandex.skip>true</jandex.skip>
    <pushDirectory>${project.build.outputDirectory}/META-INF/resources/VAADIN/static/push</pushDirectory>
    <vaadinPush.js>${pushDirectory}/vaadinPush.js</vaadinPush.js>
    <atmosphere.js.registry>https://registry.npmjs.org</atmosphere.js.registry>
    <vaadinPush-min.js>${pushDirectory}/vaadinPush-min.js</vaadinPush-min.js>
  </properties>

  <dependencies>
    <!-- Atmosphere -->
    <dependency>
      <groupId>com.vaadin.external.atmosphere</groupId>
      <artifactId>atmosphere-runtime</artifactId>
      <version>${atmosphere.runtime.version}</version>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <version>${osgi.core.version}</version>
      <scope>provided</scope>
    </dependency>

  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!--This plugin's configuration is used to store Eclipse
                    m2e settings only. It has no influence on the Maven build itself. -->
        <plugin>
          <groupId>org.eclipse.m2e</groupId>
          <artifactId>lifecycle-mapping</artifactId>
          <version>1.0.0</version>
          <configuration>
            <lifecycleMappingMetadata>
              <pluginExecutions>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <versionRange>[1.8,)</versionRange>
                    <goals>
                      <goal>run</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore/>
                  </action>
                </pluginExecution>
              </pluginExecutions>
            </lifecycleMappingMetadata>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>unpack-atmosphere-js</id>
            <goals>
              <goal>run</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <target>
                <property location="${project.build.directory}/atmosphere-js" name="javascript.unpack"/>
                <property location="${project.build.sourceDirectory}/../templates" name="templates.dir"/>
                <property location="${javascript.unpack}/atmosphere.js-${atmosphere.js.version}.tgz" name="atmosphere.js.tgz"/>

                <!-- atmosphere.js 5 is published to npm only, so this needs
                     access to an npm registry: Maven mirrors and offline mode
                     do not apply. Point atmosphere.js.registry at an npm proxy
                     where the public registry is not reachable. -->
                <mkdir dir="${javascript.unpack}"/>
                <get dest="${atmosphere.js.tgz}" skipexisting="true" src="${atmosphere.js.registry}/atmosphere.js/-/atmosphere.js-${atmosphere.js.version}.tgz"/>
                <checksum algorithm="SHA-512" file="${atmosphere.js.tgz}" property="${atmosphere.js.sha512}" verifyproperty="atmosphere.js.verified"/>
                <fail message="${atmosphere.js.tgz} does not match the atmosphere.js.sha512 checksum">
                  <condition>
                    <isfalse value="${atmosphere.js.verified}"/>
                  </condition>
                </fail>
                <untar compression="gzip" dest="${javascript.unpack}" src="${atmosphere.js.tgz}">
                  <patternset>
                    <include name="package/dist/atmosphere.global.js"/>
                  </patternset>
                </untar>

                <!-- The source map of the library does not match its position
                     inside vaadinPush.js, so it is not shipped or referenced -->
                <loadfile property="atmosphere.js.contents" srcfile="${javascript.unpack}/package/dist/atmosphere.global.js">
                  <filterchain>
                    <tokenfilter>
                      <replaceregex flags="g" pattern="//# sourceMappingURL=\S*" replace=""/>
                    </tokenfilter>
                  </filterchain>
                </loadfile>

                <loadfile property="vaadinPush.js.contents" srcfile="${templates.dir}/vaadinPush.js.tpl">
                  <filterchain>
                    <replacetokens begintoken="@" endtoken="@">
                      <token key="atmosphere.js" value="${atmosphere.js.contents}"/>
                    </replacetokens>
                  </filterchain>
                </loadfile>
                <echo file="${vaadinPush.js}">${vaadinPush.js.contents}</echo>
                <!-- atmosphere.js ships minified, so both variants are the
                     same file -->
                <copy file="${vaadinPush.js}" tofile="${vaadinPush-min.js}"/>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>compresspush</id>
            <goals>
              <goal>run</goal>
            </goals>
            <phase>compile</phase>
            <configuration>
              <target>
                <!-- Gzipped versions -->
                <gzip destfile="${vaadinPush.js}.gz" src="${vaadinPush.js}"/>
                <gzip destfile="${vaadinPush-min.js}.gz" src="${vaadinPush-min.js}"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
            <index>false</index>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
