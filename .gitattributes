# The default behavior
* text=auto

*.java text
*.html text
*.xml text
*.js text
*.svg text
*.css text
*.scss text
*.properties text
*.asciidoc text
*.md text
*.sh text eol=lf

.gitattributes text
.gitignore text

.github/workflows/*.lock.yml linguist-generated=true

vaadin-dev text eol=lf
*.ps1 text eol=lf
*.cmd text eol=crlf

flow-plugins/flow-plugin-base/src/main/resources/vaadin-dev-cli/** text eol=lf
flow-plugins/flow-plugin-base/src/main/resources/vaadin-dev-cli/*.cmd text eol=crlf
