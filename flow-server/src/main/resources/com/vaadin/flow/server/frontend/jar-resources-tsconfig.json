// This TypeScript configuration file is generated by vaadin-maven-plugin.
// Frontend sources of add-ons are copied into this folder, which the project
// tsconfig.json excludes so that the type checking rules of the project are not
// enforced on add-on sources. Bundlers apply compilerOptions only from a
// tsconfig that owns the file, and a file excluded from the project tsconfig is
// owned by no configuration, so without this file add-on sources would be
// transformed with no compilerOptions at all: TypeScript decorators would be
// left as raw syntax that browsers cannot parse.
// This file is regenerated on every build, do not edit it.
{
  "extends": "%PROJECT_TSCONFIG%",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": [
    "**/*"
  ],
  "exclude": []
}
