<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.vaadin</groupId>
    <artifactId>flow-tests</artifactId>
    <version>25.4-SNAPSHOT</version>
  </parent>

  <artifactId>vaadin-cdi-tests</artifactId>
  <name>Vaadin CDI tests</name>
  <description>Test modules for CDI integration</description>

  <properties>
    <surefire.groups/>
    <surefire.excludedGroups>com.vaadin.cdi.itest.SlowTests</surefire.excludedGroups>
    <apache-tomcat.version>11.0.26</apache-tomcat.version>
    <apache-tomee.version>10.2.0</apache-tomee.version>
    <wildfly.version>41.0.1.Final</wildfly.version>
    <openliberty.version>25.0.0.6</openliberty.version>
    <openliberty.template>jakartaee10</openliberty.template>
    <openliberty.runtimeArtifactGroupId>io.openliberty</openliberty.runtimeArtifactGroupId>
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    <!-- Every test in this module deploys to a real application server, so
         there is nothing to run until one of the container profiles below is
         activated. Skipping by default keeps a plain `mvn verify` over
         flow-tests from failing on a missing container. -->
    <cdi.container.tests.skip>true</cdi.container.tests.skip>
    <arquillian.version>1.10.2.Final</arquillian.version>
    <shrinkwrap.resolver.version>3.3.7</shrinkwrap.resolver.version>
    <shrinkwrap.descriptors.version>2.0.0</shrinkwrap.descriptors.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- The BOM rather than just arquillian-junit-container: the Liberty
           adapter pulls the Arquillian core in at 1.7.0.Final, which diverges
           from what the junit container brings and trips the DependencyConvergence
           rule the Flow parent enforces and the CDI parent did not. Nearest-wins
           already resolved these to ${arquillian.version}; the BOM makes that
           explicit for every profile instead of implicit. -->
      <dependency>
        <groupId>org.jboss.arquillian</groupId>
        <artifactId>arquillian-bom</artifactId>
        <version>${arquillian.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.jboss.shrinkwrap.resolver</groupId>
        <artifactId>shrinkwrap-resolver-impl-maven</artifactId>
        <version>${shrinkwrap.resolver.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jboss.shrinkwrap.descriptors</groupId>
        <artifactId>shrinkwrap-descriptors-impl-javaee</artifactId>
        <version>${shrinkwrap.descriptors.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>vaadin-cdi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.enterprise.concurrent</groupId>
      <artifactId>jakarta.enterprise.concurrent-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Vaadin flow; flow-html-components comes from the flow-tests parent -->
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>flow-server</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>flow-polymer-template</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Test dependencies -->
    <dependency>
      <groupId>org.jboss.arquillian.junit</groupId>
      <artifactId>arquillian-junit-container</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.shrinkwrap.resolver</groupId>
      <artifactId>shrinkwrap-resolver-impl-maven</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.shrinkwrap.descriptors</groupId>
      <artifactId>shrinkwrap-descriptors-impl-javaee</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.vaadin</groupId>
        <artifactId>flow-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>prepare-frontend</goal>
              <goal>build-frontend</goal>
            </goals>
            <phase>compile</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipTests>${cdi.container.tests.skip}</skipTests>
        </configuration>
      </plugin>
      <plugin>
        <!-- The Flow parent runs parse-version, which sets properties whose
             names end in a question mark. That is a legal Maven property name
             but not a legal XML element name, so help:effective-pom below
             serialises tags no parser accepts - and ShrinkWrap reads that file
             with a strict POM reader. Nothing in this module reads
             ${parsedVersion.*} (osgi.bundle.version is the only consumer in the
             repository, and it is read by bnd, which needs a bnd.bnd this
             module does not have), so the cheapest fix is not to produce the
             properties at all. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>parse-version</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!--
                JBoss shrinkwrap archive provider builds war based on pom file,
                so generate effective pom to record any command-line property
                overrides.
                -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-help-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <output>${project.build.directory}/effective-pom.xml</output>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>effective-pom</goal>
            </goals>
            <phase>generate-test-resources</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!--
                ShrinkWrap parses the effective POM above with a strict POM
                reader, and what help:effective-pom writes is not well-formed
                XML: it carries an XML declaration from the plugin's own banner
                and a second one from the rendered model, which the reader
                rejects as a "PITarget with reserved xml name". Which of the
                plugin's rendering paths is taken depends on the model, so this
                shows up under the Flow parent but did not under the CDI one.

                The declaration does not matter here - ShrinkWrap reads this
                file for the dependency list, and a POM needs no declaration
                since UTF-8 is the default - so strip it rather than reshaping
                the Flow build around a test module.

                Declared after maven-help-plugin on purpose: executions bound
                to the same phase run in plugin declaration order.
                -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <!-- Declaring antrun here also picks up the execution the flow-tests
               parent manages, which deletes an exploded WAR's WEB-INF/lib. This
               module is packaged as a jar and ShrinkWrap assembles its archives
               in process, so that directory never exists and the execution only
               prints an Ant BuildException and a stack trace on every run. -->
          <execution>
            <id>delete-lib-folder</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>sanitize-effective-pom</id>
            <goals>
              <goal>run</goal>
            </goals>
            <phase>generate-test-resources</phase>
            <configuration>
              <!-- The flow-tests parent turns this off for its own execution;
                   a silent failure here would only resurface as every test
                   failing to build its archive. -->
              <failOnError>true</failOnError>
              <target>
                <!-- Everything preceding the root element. -->
                <replaceregexp byline="false" file="${project.build.directory}/effective-pom.xml" flags="s" match="^.*?(&lt;project)" replace="\1"/>
                <!-- Fail here rather than in every test's deployment method if
                     the output ever changes shape again - an illegal element
                     name reintroduced by another plugin included. -->
                <xmlvalidate file="${project.build.directory}/effective-pom.xml" lenient="true"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>tomee</id>
      <properties>
        <cdi.container.tests.skip>false</cdi.container.tests.skip>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.apache.tomee</groupId>
          <artifactId>arquillian-tomee-remote</artifactId>
          <version>${apache-tomee.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.apache.tomee</groupId>
          <artifactId>apache-tomee</artifactId>
          <version>${apache-tomee.version}</version>
          <classifier>webprofile</classifier>
          <type>zip</type>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>${maven.surefire.plugin.version}</version>
            <configuration>
              <excludedGroups>${surefire.excludedGroups}</excludedGroups>
              <groups>${surefire.groups}</groups>
              <systemPropertyVariables>
                <tomee.host>0.0.0.0</tomee.host>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>wildfly</id>
      <properties>
        <cdi.container.tests.skip>false</cdi.container.tests.skip>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.wildfly.arquillian</groupId>
          <artifactId>wildfly-arquillian-container-managed</artifactId>
          <version>5.1.0.Final</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-simple</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>${maven-dependency-plugin.version}</version>
            <executions>
              <execution>
                <id>unpack</id>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <phase>process-test-classes</phase>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.wildfly</groupId>
                      <artifactId>wildfly-dist</artifactId>
                      <version>${wildfly.version}</version>
                      <type>zip</type>
                      <outputDirectory>target</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>${maven.surefire.plugin.version}</version>
            <configuration>
              <excludedGroups>${surefire.excludedGroups}</excludedGroups>
              <groups>${surefire.groups}</groups>
              <systemPropertyVariables>
                <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                <jboss.home>${project.build.directory}/wildfly-${wildfly.version}</jboss.home>
                <arquillian.launch>wildfly</arquillian.launch>
              </systemPropertyVariables>
              <redirectTestOutputToFile>false</redirectTestOutputToFile>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>payara</id>
      <properties>
        <cdi.container.tests.skip>false</cdi.container.tests.skip>
      </properties>
      <dependencies>
        <dependency>
          <groupId>fish.payara.arquillian</groupId>
          <artifactId>arquillian-payara-server-managed</artifactId>
          <version>3.1</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-simple</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <!-- Bound to the phase before the unpack below rather than to the
                 same one: executions sharing a phase run in plugin declaration
                 order, and a plugin a profile adds runs ahead of one the module
                 declares for every phase, so same-phase would delete what the
                 unpack had just written.

                 Every version now unpacks over the same path, so a target
                 directory left by an earlier run has to go before the next one
                 fills it: otherwise a 7.x distribution lands on top of the 6.x
                 files it does not replace, and the server starts from a mix of
                 the two. The unpack below is forced (overWrite) for the same
                 reason - the plugin remembers what it unpacked in a marker file
                 keyed by the coordinates alone, so with the directory gone and
                 the marker kept it would skip the work and leave nothing behind
                 for Arquillian to start. Re-unpacking costs a few seconds per
                 run and is what keeps the install pristine. -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>remove-previous-payara</id>
                <goals>
                  <goal>run</goal>
                </goals>
                <phase>test-compile</phase>
                <configuration>
                  <!-- The parent turns Ant errors into warnings; here a failed
                       delete is what the unpack would then build a mixed
                       install on, so fail instead. -->
                  <failOnError>true</failOnError>
                  <target>
                    <delete dir="${project.build.directory}/payara"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>${maven-dependency-plugin.version}</version>
            <executions>
              <execution>
                <id>unpack</id>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <phase>process-test-classes</phase>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>fish.payara.distributions</groupId>
                      <artifactId>payara</artifactId>
                      <version>7.2026.9</version>
                      <type>zip</type>
                      <overWrite>true</overWrite>
                      <outputDirectory>target</outputDirectory>
                      <!-- The distribution unpacks into a directory named
                           after its major version - payara6 for 6.x, payara7
                           for 7.x - which payara.home below would otherwise
                           have to repeat, so a major upgrade of the zip alone
                           leaves Arquillian pointed at a directory that does
                           not exist ("... is not a valid GlassFish
                           installation"). Rename the root entry to a plain
                           "payara" while unpacking so the path holds for any
                           version. The wildfly and tomcat profiles get this
                           for free: their distributions carry the full version
                           in the directory name, so their home paths
                           interpolate the same property the artifact does. -->
                      <fileMappers>
                        <fileMapper implementation="org.codehaus.plexus.components.io.filemappers.RegExpFileMapper">
                          <pattern>^payara[0-9]+</pattern>
                          <replacement>payara</replacement>
                        </fileMapper>
                      </fileMappers>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>${maven.surefire.plugin.version}</version>
            <configuration>
              <excludedGroups>${surefire.excludedGroups}</excludedGroups>
              <groups>${surefire.groups}</groups>
              <systemPropertyVariables>
                <payara.home>${project.build.directory}/payara</payara.home>
                <arquillian.launch>payara</arquillian.launch>
                <vaadin.bowerMode>true</vaadin.bowerMode>
              </systemPropertyVariables>
              <redirectTestOutputToFile>false</redirectTestOutputToFile>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>liberty</id>
      <properties>
        <cdi.container.tests.skip>false</cdi.container.tests.skip>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.openliberty.arquillian</groupId>
          <artifactId>arquillian-liberty-managed-jakarta-junit</artifactId>
          <version>3.0.0</version>
          <type>pom</type>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>io.openliberty.tools</groupId>
            <artifactId>liberty-maven-plugin</artifactId>
            <version>3.12.3</version>
            <executions>
              <execution>
                <id>create-server</id>
                <goals>
                  <goal>create</goal>
                  <goal>install-feature</goal>
                  <goal>configure-arquillian</goal>
                </goals>
                <phase>process-test-classes</phase>
                <configuration>
                  <runtimeArtifact>
                    <groupId>${openliberty.runtimeArtifactGroupId}</groupId>
                    <artifactId>openliberty-runtime</artifactId>
                    <version>${openliberty.version}</version>
                    <type>zip</type>
                  </runtimeArtifact>
                  <useOpenLiberty>true</useOpenLiberty>
                  <template>${openliberty.template}</template>
                  <features>
                    <feature>jakartaee-10.0</feature>
                    <feature>localConnector-1.0</feature>
                  </features>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- liberty-maven-plugin:install-feature goal installs new features but does not update
                         server.xml file. localConnector-1.0 needs to be present in server.xml for Arquillian -->
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.2.0</version>
            <executions>
              <execution>
                <goals>
                  <goal>run</goal>
                </goals>
                <phase>process-test-classes</phase>
                <configuration>
                  <target>
                    <copy file="${project.build.testSourceDirectory}/../resources/liberty/server.xml" overwrite="true" tofile="${project.build.directory}/liberty/wlp/usr/servers/defaultServer/server.xml"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>${maven.surefire.plugin.version}</version>
            <configuration>
              <excludedGroups>${surefire.excludedGroups}</excludedGroups>
              <groups>${surefire.groups}</groups>
              <systemPropertyVariables>
                <arquillian.launch>liberty_managed</arquillian.launch>
              </systemPropertyVariables>
              <redirectTestOutputToFile>false</redirectTestOutputToFile>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>tomcat-weld</id>
      <properties>
        <cdi.container.tests.skip>false</cdi.container.tests.skip>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.jboss.arquillian.container</groupId>
          <artifactId>arquillian-tomcat-managed-10</artifactId>
          <version>1.2.5.Final</version>
          <scope>test</scope>
        </dependency>
        <!-- Weld servlet for testing CDI injections -->
        <dependency>
          <groupId>org.jboss.weld.servlet</groupId>
          <artifactId>weld-servlet-shaded</artifactId>
          <version>${weld.version}</version>
          <scope>test</scope>
        </dependency>
        <!-- No scope on purpose: it overrides the provided scope this
             module declares above, so the API reaches the compile classpath
             (src/main/java/.../push/ManagedExecutorPushComponent.java) and the
             archive ShrinkWrap assembles. Tomcat+Weld is not a full Jakarta EE
             server and supplies neither. -->
        <dependency>
          <groupId>jakarta.enterprise.concurrent</groupId>
          <artifactId>jakarta.enterprise.concurrent-api</artifactId>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>${maven-dependency-plugin.version}</version>
            <executions>
              <execution>
                <id>unpack</id>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <phase>process-test-classes</phase>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.apache.tomcat</groupId>
                      <artifactId>tomcat</artifactId>
                      <version>${apache-tomcat.version}</version>
                      <type>zip</type>
                      <outputDirectory>target</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>setup-tomcat-users</id>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <phase>process-test-classes</phase>
                <configuration>
                  <resources>
                    <resource>
                      <directory>${project.basedir}/src/test/resources/tomcat</directory>
                      <includes>
                        <include>tomcat-users.xml</include>
                      </includes>
                    </resource>
                  </resources>
                  <outputDirectory>${project.build.directory}/apache-tomcat-${apache-tomcat.version}/conf</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>${maven.surefire.plugin.version}</version>
            <configuration>
              <excludedGroups>com.vaadin.cdi.itest.NeedsCDICompliantContainer,${surefire.excludedGroups}</excludedGroups>
              <groups>${surefire.groups}</groups>
              <systemPropertyVariables>
                <arquillian.launch>tomcat-weld</arquillian.launch>
                <catalina.home>${project.build.directory}/apache-tomcat-${apache-tomcat.version}</catalina.home>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>slow-tests</id>
      <properties>
        <surefire.excludedGroups/>
        <surefire.groups>com.vaadin.cdi.itest.SlowTests</surefire.groups>
      </properties>
    </profile>
  </profiles>
</project>
