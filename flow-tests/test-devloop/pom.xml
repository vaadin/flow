<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.vaadin</groupId>
    <artifactId>flow-tests</artifactId>
    <version>25.4-SNAPSHOT</version>
  </parent>
  <artifactId>flow-test-devloop</artifactId>
  <packaging>pom</packaging>
  <name>Flow dev loop tests</name>
  <description>End-to-end tests for the vaadin-dev CLI and the dev-loop daemon, one fixture per shape of application.</description>

  <!-- One fixture per shape of Vaadin application, because the shape is what
       the dev loop has to tell apart: test-devloop-spring is an application
       with an entry point, launched as `java -cp ... <MainClass>`, and
       test-devloop-jetty is a WAR with none, run by the project's own build
       plugin. test-devloop-cargo is that second shape again with the one
       difference that costs the loop the most - the container runs as a process
       of its own and is handed a deployed copy of the WAR, rather than serving
       the module's output inside the build's JVM. The rest are that forked
       shape on the other servers the dev loop drives, each through its own
       build plugin - TomEE, JBoss EAP, Open Liberty, Payara Server and Payara
       Micro - because each hands the loop's JVM flags to the server by a
       channel of its own, and keeps its run goal to one module by a mechanism
       of its own. Each is its own multi-module
       reactor, because the interesting case - an edit in a sibling library
       reaching the running page - only exists if there is a sibling, and each
       runs the shared ITs out of test-devloop-support against its own
       application.

       test-devloop-support sits here with them and is deliberately not listed
       below: flow-tests declares it among the modules it builds regardless of
       -DskipTests, which is how CI gets it into the local repository before the
       IT jobs - which build no test module at all - resolve it. Declaring it in
       both places would put the same project in one reactor twice. -->
  <modules>
    <module>test-devloop-spring</module>
    <module>test-devloop-jetty</module>
    <module>test-devloop-cargo</module>
    <module>test-devloop-tomee</module>
    <module>test-devloop-jbosseap</module>
    <module>test-devloop-liberty</module>
    <module>test-devloop-payara</module>
    <module>test-devloop-payara-micro</module>
  </modules>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- The ITs the maven-compile execution below runs: the ones that put the
         compile leg through its paths - an apply, an edit in a sibling module,
         a deleted source. -Pdevloop-maven-compile runs every IT instead. -->
    <devloop.maven-compile.its>**/DevLoopApplyIT.java, **/DevLoopMultiModuleIT.java, **/DevLoopDeletionIT.java</devloop.maven-compile.its>
  </properties>

  <build>
    <plugins>
      <!-- Every fixture runs its ITs twice: the default execution with the
           daemon compiling applies with javac, its default, and this one with
           -Dvaadin.dev.compiler=maven, the opt-in. A run of its own rather than
           a parameter on each test: the compiler is fixed for a daemon's life,
           and each failsafe run starts its own daemon. Its reports go to a
           directory of their own so the two verify goals read their own
           summaries. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <id>maven-compile</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
            <configuration>
              <!-- includes rather than test, which would also override the
                   excludes a fixture declares for ITs it cannot pass. -->
              <includes>
                <include>${devloop.maven-compile.its}</include>
              </includes>
              <reportsDirectory>${project.build.directory}/failsafe-reports-maven-compile</reportsDirectory>
              <summaryFile>${project.build.directory}/failsafe-reports-maven-compile/failsafe-summary.xml</summaryFile>
              <systemPropertyVariables>
                <devloop.it.compiler>maven</devloop.it.compiler>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The whole suite compiled by Maven, and only that:
         mvn verify -Pdevloop-maven-compile -pl <fixture>/devloop-app
         Narrow it with -Ddevloop.maven-compile.its=**/DevLoopApplyIT.java. -->
    <profile>
      <id>devloop-maven-compile</id>
      <properties>
        <devloop.maven-compile.its>**/*IT.java</devloop.maven-compile.its>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <id>default</id>
                <configuration>
                  <skipITs>true</skipITs>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
