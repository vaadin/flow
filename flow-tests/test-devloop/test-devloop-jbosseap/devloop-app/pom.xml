<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.vaadin</groupId>
    <artifactId>flow-test-devloop-jbosseap</artifactId>
    <version>25.4-SNAPSHOT</version>
  </parent>
  <artifactId>flow-test-devloop-jbosseap-app</artifactId>
  <!-- A WAR, and unlike the Jetty fixture's one it is deployed rather than
       served in place: the WildFly plugin provisions a JBoss EAP under target/,
       starts it as a process of its own and deploys the packaged WAR into it. No
       src/main/webapp and no web.xml, matching a generated WAR starter - Flow
       registers its servlet from an annotated listener the container scans, and
       static files come from META-INF/resources in the jars on the webapp class
       path. -->
  <packaging>war</packaging>
  <name>Flow dev loop tests: JBoss EAP application</name>
  <description>The WAR the JBoss EAP dev-loop fixture runs on Red Hat JBoss EAP 8.1.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- Not 8080, and not 8894..8899 either: those are the other dev-loop
         fixtures, and no two of them may take each other's port. EAP's own
         default is 8080; this overrides it through the jboss.http.port
         system property the provisioned standalone.xml reads. -->
    <server.port>8893</server.port>
    <!-- JBoss EAP 8.1 is provisioned from Red Hat's Maven repository rather
         than downloaded as a zip: the zip installer needs a customer portal
         login, the Galleon feature pack does not. The feature pack carries no
         version here on purpose - the channel below is what pins it, which is
         how Red Hat documents EAP 8.1 provisioning. -->
    <eap.channel.version>1.8.0.GA-redhat-00006</eap.channel.version>
    <wildfly.plugin.version>5.1.5.Final</wildfly.plugin.version>
    <!-- Run the ITs on the JUnit Platform (JUnit 6), like the other fixtures. -->
    <failsafe.provider.artifactId>surefire-junit-platform</failsafe.provider.artifactId>
    <!-- The parent's groups/excludedGroups are JUnit 4 @Category class names,
         which mean nothing to the JUnit Platform provider. Cleared so this
         module runs its ITs the way the other fixtures do. -->
    <groups/>
    <excludedGroups/>
    <!-- One daemon, one application process, one browser page kept open across
         applies: nothing here is parallelizable. -->
    <failsafe.parallel>none</failsafe.parallel>
    <failsafe.perCoreThreadCount>false</failsafe.perCoreThreadCount>
    <failsafe.threadCount>1</failsafe.threadCount>
  </properties>

  <!-- Where the EAP channel, the feature pack and everything they resolve come
       from. The GA repository is public; only the zip installer behind the
       customer portal is not. -->
  <repositories>
    <repository>
      <id>redhat-ga</id>
      <url>https://maven.repository.redhat.com/ga/</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <!-- This fixture has no Spring BOM to inherit the JUnit Platform version
           from, so it imports the JUnit BOM directly: without it only the
           artifacts the root pom manages by name are at
           ${junit.jupiter.version}, and junit-platform-engine arrives at the
           JUnit 5 version TestBench was built against, which the launcher
           rejects as a mismatched platform. Declared before the TestBench BOM
           so it wins for the artifacts both could manage. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.jupiter.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.vaadin</groupId>
        <artifactId>vaadin-testbench-bom</artifactId>
        <version>${testbench.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The dev loop travels in with the dev server, exactly as it does for a
         user application that declares com.vaadin:vaadin-dev.

         Deliberately NOT <optional>true</optional>, which is what the Jetty
         fixture writes: maven-war-plugin leaves optional dependencies out of
         WEB-INF/lib, so the dev loop would never reach the container and the
         application would start but never register with the daemon. Jetty does
         not show this, because in EMBED mode the webapp class loader is the
         project's own classpath rather than a packaged WAR. A generated Vaadin
         starter avoids it the other way round, by declaring vaadin-dev in a
         non-optional `development` profile. -->
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>vaadin-dev-server</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The sibling library, depended on like any other jar. An edit there has
         to reach the running app through a webapp class loader the container
         built from the deployed WAR, which is the multi-module question this
         fixture answers. -->
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>flow-test-devloop-jbosseap-shared</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Driving the CLI and patching sources, shared with the other fixtures so
         the harnesses cannot drift apart. -->
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>flow-test-devloop-support</artifactId>
      <version>${project.version}</version>
      <!-- Its ITs are test sources there, so they arrive as a test-jar. -->
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>vaadin-testbench-core-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- DevLoopPomEditIT adds a dependency below this line and reverts it. The
         anchor is explicit because "</dependencies>" also closes the one inside
         <dependencyManagement>, where a dependency without a version is an
         invalid model rather than a classpath change. -->
  </dependencies>

  <build>
    <plugins>
      <!-- The ITs every fixture runs live in flow-test-devloop-support and are
           run from there, rather than through a subclass per module that would
           add a file and a name for nothing. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <dependenciesToScan>
            <dependency>com.vaadin:flow-test-devloop-support</dependency>
          </dependenciesToScan>
          <!-- A deployed WAR cannot see a resource refreshed in the module's
               own output; the same exclusion the Cargo fixture carries. -->
          <excludes>
            <exclude>**/DevLoopCssIT.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.vaadin</groupId>
        <artifactId>flow-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>prepare-frontend</goal>
            </goals>
          </execution>
          <!-- Dogfooding: the CLI this fixture is driven with is the one the
               goal installs. -->
          <execution>
            <id>install-dev-cli</id>
            <goals>
              <goal>install-dev-cli</goal>
            </goals>
            <phase>process-resources</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.wildfly.plugins</groupId>
        <artifactId>wildfly-maven-plugin</artifactId>
        <version>${wildfly.plugin.version}</version>
        <configuration>
          <!-- What makes this EAP rather than community WildFly. `wildfly:run`
               provisions nothing itself - it has no <channels> parameter at all
               - so the server is provisioned by the execution below and `run`
               finds it in <provisioning-dir> and starts it. -->
          <provisioning-dir>eap-server</provisioning-dir>
          <feature-packs>
            <feature-pack>
              <location>org.jboss.eap:wildfly-ee-galleon-pack</location>
            </feature-pack>
          </feature-packs>
          <channels>
            <channel>
              <manifest>
                <groupId>org.jboss.eap.channels</groupId>
                <artifactId>eap-8.1</artifactId>
                <version>${eap.channel.version}</version>
              </manifest>
            </channel>
          </channels>
          <!-- Root context, so the view is at http://localhost:8893/ rather
               than under the artifact's name: WildFly reads the context path
               off the deployment name, and ROOT.war means "/". -->
          <name>ROOT.war</name>
          <!-- The port, and not through <javaOpts>: that parameter is the dev
               loop's channel for its agents, and a pom that writes it takes the
               agents away. Server arguments reach the server's command line as
               system properties, which is what standalone.xml reads the HTTP
               port from. -->
          <server-args>
            <server-arg>-Djboss.http.port=${server.port}</server-arg>
            <!-- The daemon owns this process and decides when a change goes
                 live, so nothing else may push to the browser on its own. -->
            <server-arg>-Dvaadin.frontend.hotdeploy=false</server-arg>
          </server-args>
        </configuration>
        <executions>
          <!-- Provisioning is bound to the build rather than left to `run`,
               because `run` can only provision community WildFly from the
               universe. `wildfly:run` forks the lifecycle up to `package`, so
               this execution is what a `vaadin-dev start` runs before the
               server is started - once; a provisioned server is reused. -->
          <execution>
            <id>provision-eap</id>
            <goals>
              <goal>provision</goal>
            </goals>
            <phase>prepare-package</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
